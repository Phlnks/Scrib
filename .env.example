# ==============================================================================
# SCRIB - CONFIGURATION DU SERVEUR PRIVÉ (.env)
# ==============================================================================
# Renommez ou copiez ce fichier en `.env` à la racine du projet :
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLÉ D'API GOOGLE GEMINI (OBLIGATOIRE)
# ------------------------------------------------------------------------------
# Obtenez votre clé API sur la console pour les développeurs Google :
# Utilisée pour la transcription audio, le découpage automatique et les synthèses textuelles.
GEMINI_API_KEY="AIzaSy..."

# ------------------------------------------------------------------------------
# 2. NOM DE DOMAINE & URL PUBLIQUE
# ------------------------------------------------------------------------------
# L'adresse URL publique HTTPS complète de votre instance Scrib.
# Exemple : https://scrib.votredomaine.com ou https://transcribe.monentreprise.fr
APP_URL="https://scrib.votredomaine.com"

# ------------------------------------------------------------------------------
# 3. CONFIGURATION RÉSEAU DU SERVEUR
# ------------------------------------------------------------------------------
# Le port d'écoute interne de l'application Node.js (3000 par défaut).
# Si vous utilisez un reverse-proxy Nginx ou Caddy, ce dernier redirigera vers ce port.
PORT=3000

# L'adresse IP de liaison :
# - "0.0.0.0" pour écouter sur toutes les interfaces réseau (ou conteneur Docker).
# - "127.0.0.1" si Nginx/Caddy tourne sur la même machine hôte et que vous souhaitez restreindre l'accès direct.
HOST="0.0.0.0"

# ------------------------------------------------------------------------------
# 4. ENVIRONNEMENT & REVERSE PROXY
# ------------------------------------------------------------------------------
# Définir à "production" sur votre serveur pour désactiver le mode dev Vite et servir le build optimisé.
NODE_ENV="production"

# Active la reconnaissance des en-têtes X-Forwarded-Proto / X-Forwarded-For transmis par Nginx, Caddy, Traefik ou Cloudflare.
TRUST_PROXY="true"

# ------------------------------------------------------------------------------
# 5. LIMITES D'ENVOI AUDIO
# ------------------------------------------------------------------------------
# Taille maximale autorisée pour le payload base64 des fichiers ou segments audio (75mb par défaut).
# Pensez à ajuster également `client_max_body_size 100M;` dans Nginx si applicable.
BODY_LIMIT="75mb"
